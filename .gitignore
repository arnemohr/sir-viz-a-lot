# Rust
/target/

# IDE / editor
.idea/
.vscode/
.zed/
*.swp
*.swo

# macOS
.DS_Store

# Local mise overrides
.mise.local.toml

# Optional rustup pin if a contributor prefers rustup over mise (see mise.toml)
rust-toolchain.toml

# User-saved projects (rarely belong in the repo). The literal `~/` dir
# is what gets created when the operator types `~/foo` into the save-
# path field — that field doesn't shell-expand.
*.rmap.json
/~/

# 003-T2.8 — un-ignore bundled demo projects under assets/demos/.
# They ARE part of the repo (the launcher's "Try a demo" button needs
# them) and ship inside the .app bundle. User shows still don't belong
# in the tree, so the broad *.rmap.json ignore stays.
!/assets/demos/*.rmap.json

